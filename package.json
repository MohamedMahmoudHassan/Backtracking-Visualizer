{
  "name": "sudoku-solver-visualizer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "start": "node server.js",
    "postinstall": "npx browserslist@latest --update-db"
  },
  "dependencies": {
    "core-js": "^3.36.1",
    "express": "^4.19.2",
    "serve-static": "^1.16.2",
    "vue": "^2.7.16",
    "vuetify": "^2.7.3"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4.5.21",
    "@vue/cli-plugin-eslint": "~4.5.21",
    "@vue/cli-service": "~4.5.21",
    "babel-eslint": "^10.1.0",
    "eslint": "^6.8.0",
    "eslint-plugin-vue": "^6.2.2",
    "sass": "~1.64.0",
    "sass-loader": "^10.5.2",
    "vue-cli-plugin-vuetify": "~2.5.8",
    "vue-template-compiler": "^2.7.16",
    "vuetify-loader": "^1.9.2"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  }
}
